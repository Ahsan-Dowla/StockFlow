# ==============================================================================
# StockFlow — Git Ignore Specification
# ==============================================================================

# Environment and Secret Files
.env
.env.*
.env.local
.env.development
.env.production
!.env.example
*.pem
*.key
*.p12
*.jks
credentials.json
application-secret.yml

# Local machine tooling & caches
.tools/
.cache/
*.tmp

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Java & Maven Artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Node & Frontend Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Outputs & Coverage
test-output/
coverage/
test-results/
playwright-report/
.jacoco/
jacoco.exec

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-workspace
.project
.classpath
.settings/
bin/
