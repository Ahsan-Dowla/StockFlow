# ==============================================================================
# StockFlow — Environment Variable Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env (e.g., `cp .env.example .env` or `Copy-Item .env.example .env`)
# 2. Replace all placeholder values marked with CHANGE_ME or REPLACE_WITH_*
# 3. NEVER commit the real .env file to version control.
# ==============================================================================

# ─── PostgreSQL Database Configuration ────────────────────────────────────────
# Superuser password for container database administration (Docker only)
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Application database user (used by Spring Boot)
DB_USERNAME=stockflow_app

# Application database password (used by Spring Boot and created by DB init script)
DB_PASSWORD=CHANGE_ME

# Host port for container PostgreSQL (default: 5433 to avoid host 5432 conflicts)
DB_HOST_PORT=5433

# Database connection URL for host/local Spring Boot runs (optional in Docker)
DB_URL=jdbc:postgresql://localhost:5432/stockflow

# ─── Application Server Configuration ─────────────────────────────────────────
# Internal Spring Boot backend port
SERVER_PORT=8090

# Host port exposed for Spring Boot backend
BACKEND_PORT=8091

# Host port exposed for React / Nginx frontend
FRONTEND_PORT=5173

# ─── Security & JWT Authentication ────────────────────────────────────────────
# Cryptographic secret for signing Nimbus JWT tokens.
# Must be at least 256 bits (32 bytes / 64 hex characters).
# Generate securely via: `openssl rand -hex 32`
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# JWT token expiration time in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ─── Administrator Bootstrap Credentials ──────────────────────────────────────
# On startup, if no administrator account exists, one is seeded with these credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=System Administrator

# ─── Cross-Origin Resource Sharing (CORS) ─────────────────────────────────────
# Comma-separated list of allowed web origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
